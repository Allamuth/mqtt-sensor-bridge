#!/bin/bash

#MQTT broker details
mqtt_broker="{{ hostvars['home-assistant.lan'].ansible_hostname }}"
mqtt_port=1883
mqtt_user=
mqtt_password=
mqtt_base_state_topic="servers/{{ ansible_hostname }}/"

# Function to publish sensor value to MQTT
publish_mqtt() {
    local topic_suffix=$1
    local value=$2
    local retained=$3
    local full_topic="${mqtt_base_state_topic}${topic_suffix}"
    
    local retained_flag=""
    if [ "$retained" == "true" || "$retained" == "1"]; then
        retained_flag="-r"
    fi

    if [ -n "$mqtt_user" ]; then
        mosquitto_pub -h "$mqtt_broker" -p "$mqtt_port" -u "$mqtt_user" -P "$mqtt_password" -t "$full_topic" -m "$value" -q 1 $retained_flag
    else
        mosquitto_pub -h "$mqtt_broker" -p "$mqtt_port" -t "$full_topic" -m "$value" -q 1 $retained_flag
    fi
}

# Check if mosquitto_pub is available
if ! command -v mosquitto_pub &> /dev/null; then
    echo "Error: mosquitto_pub not found. Please install mosquitto-clients." >&2
    exit 1
fi

# Check if smartctl is available
if ! command -v smartctl &> /dev/null; then
    echo "Error: smartctl not found. Please install smartmontools." >&2
    exit 1
fi

# Find all /dev/sd* devices (excluding partitions like sda1, sdb2, etc.)
# TODO: Find devices once and store in config to iterate over list instead of searching every time, move to other script?
# TODO: check if number of devices changed to see if a new drive was added or removed. Move to other script?
# TODO: if drive was removed/is missing throw error (create error also in HA)
devices=$(ls /dev/sd[a-z] /dev/nvme[0-9]n[0-9] /dev/hd[a-z] /dev/vd[a-z] 2>/dev/null)

if [ -z "$devices" ]; then
    echo "No /dev/sd* devices found." >&2
    exit 1
fi

# TODO: look for other attributes to process and include them here including proper handling per device, run smartctl once to safe on time!
# TODO: include drive name and slot? if possible. ID is written on drive so would be a good way to order them to location in case
#TODO: if value is missing send retained unavailable to ensure reporting at HA side
# Process each device
for device in $devices; do
    topic_suffix="disk_temp/$device"

    # Get the raw temperature value from attribute 190 or 194
    temp=$(smartctl -A "$device" 2>/dev/null | awk '/^190/ {print $10; exit} /^194/ {print $10}')

    if [ -n "$temp" ]; then
        publish_mqtt "$topic_suffix" "$temp"
    else
        publish_mqtt "$topic_suffix" "unavailable" "true"
    fi
done